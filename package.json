{
  "name": "reset-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ResET — Aplicativo desktop de comunicação em grupo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@reset/server",
    "dev:desktop": "npm run dev --workspace=@reset/desktop",
    "migrate": "npm run migrate --workspace=@reset/server",
    "migrate:prod": "npm run migrate:prod --workspace=@reset/server",
    "bootstrap:admin": "npm run bootstrap:admin --workspace=@reset/server",
    "bootstrap:admin:prod": "npm run bootstrap:admin:prod --workspace=@reset/server",
    "build:server": "npm run build --workspace=@reset/server",
    "build:desktop": "npm run build --workspace=@reset/desktop",
    "build": "npm run build --workspace=@reset/shared && npm run build --workspace=@reset/server && npm run build --workspace=@reset/desktop",
    "test": "vitest run --exclude apps/server/src/__tests__/integration/**",
    "test:integration": "vitest run apps/server/src/__tests__/integration/database.test.ts",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true
  }
}
